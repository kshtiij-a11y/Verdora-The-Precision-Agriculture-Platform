
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow authenticated users to create farmer registration documents only.
    match /farmerregs/{farmerId} {
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly([
                      'name',
                      'phone',
                      'village',
                      'district',
                      'crop',
                      'secondaryCrop',
                      'language',
                      'createdAt'
                    ])
                    && request.resource.data.name is string
                    && request.resource.data.phone is string
                    && request.resource.data.village is string
                    && request.resource.data.district is string
                    && request.resource.data.crop is string
                    && request.resource.data.secondaryCrop is string
                    && request.resource.data.language is string
                    && request.resource.data.createdAt is timestamp;
      allow read, update, delete: if false;
    }

    // Explicitly deny direct access; this path is not used by the app.
    match /activeFarmer/{docId} {
        allow read, write: if false;
    }

    // By default, deny all other reads and writes to the database.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
